# docusign-pdf-field-extractor — Netlify env vars
# Never commit the real .env.local — this file is the template only.
# Set real values directly in Netlify's dashboard (Site settings -> Environment variables),
# or in a local .env.local (gitignored) for `netlify dev` — never through Claude/any automated
# tool call, per this project's private-key-handling convention.

# Required by /onboard-pdf and /add-field-tab. /extract-fields alone needs none of this (it's
# pure PDF-in, field-list-out).

# DocuSign (sandbox/demo) — JWT Grant auth + creating Templates from onboarded PDFs.
DOCUSIGN_AUTH_BASE_URL=https://account-d.docusign.com
DOCUSIGN_API_BASE_URL=https://demo.docusign.net/restapi
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_RSA_PRIVATE_KEY=

# Milemarker (Flatiron tenant) — for creating the matching Workflow + Form via API.
MILEMARKER_BASE_URL=https://fi.app.milemarker.co/api/v1
MILEMARKER_API_KEY=
# Resolve these once via GET /workflow-lookups against the tenant (see workflow 55's own
# creation this session for Flatiron's current values: type 5 "Operations",
# category 8 "Operations Request", access level 1 "Admin", assignee 39 "Carl Manuel").
MILEMARKER_WORKFLOW_TYPE_ID=
MILEMARKER_WORKFLOW_CATEGORY_ID=
MILEMARKER_WORKFLOW_ACCESS_LEVELS=1
MILEMARKER_DEFAULT_ASSIGNEES=
# The existing n8n projection every onboarded workflow's create-trigger gets attached to —
# the shared "FLATIRON | Generic Doc Onboarding" n8n workflow's projection id (18 for
# Flatiron). One n8n workflow serves every onboarded document; this is NOT a new projection
# created per document. Resolve via GET /workflow-projections if it's ever unclear.
MILEMARKER_N8N_PROJECTION_ID=

# n8n (shared host) — not directly called by this service (the projection attach above goes
# through Milemarker's Workflow Projection Setup API, not n8n's own API); kept here for
# reference/debugging the n8n side of the pipeline.
N8N_FLATIRON_BASE_URL=https://projection.milemarker-cloud.com
N8N_FLATIRON_API_KEY=

# MCP server (/mcp endpoint) — shared secret checked as `Authorization: Bearer <key>`.
# Leave unset to disable auth (fine for local `netlify dev`); always set it once deployed,
# since /mcp can trigger real DocuSign envelope + Milemarker workflow creation.
MCP_SERVER_KEY=
